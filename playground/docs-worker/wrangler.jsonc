{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "react-find-docs",
  "main": "src/index.js",
  "compatibility_date": "2026-03-18",
  "workers_dev": true,
  "minify": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
